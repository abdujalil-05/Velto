# --- Database ---
# Roles: packages/database/scripts/provision-roles.sql. The app role must
# never be a superuser/BYPASSRLS role — those skip RLS even with FORCE.
# RLS-bound application role (runtime + tests).
DATABASE_URL="postgresql://velto_app:velto_app@localhost:5433/velto_dev?schema=public"
# Schema owner — used only by the Prisma CLI (migrate), via `directUrl`.
DATABASE_MIGRATE_URL="postgresql://velto_owner:velto_owner@localhost:5433/velto_dev?schema=public"
# BYPASSRLS role — used only for cross-tenant bootstrap (login-by-phone) and
# background jobs. See packages/database/scripts/provision-roles.sql.
DATABASE_SYSTEM_URL="postgresql://velto_system:velto_system@localhost:5433/velto_dev?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6380"
# BullMQ key prefix. Use a distinct value per environment sharing one Redis (dev/staging/test). Default "bull" = BullMQ default.
BULLMQ_PREFIX="bull"

# --- Object storage (S3-compatible / MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="velto"
S3_SECRET_KEY="velto12345"
S3_BUCKET="velto-dev"
S3_FORCE_PATH_STYLE="true"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
# initData freshness window (seconds) and max logins per identical initData within it (replay cap).
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
TELEGRAM_INITDATA_MAX_USES=20
# Set when registering the webhook: `setWebhook` call's secret_token param.
TELEGRAM_WEBHOOK_SECRET=""

# --- Offline sync ---
# Max documents per POST /sync/push batch (1..100, TZ 10.3 default 20).
SYNC_PUSH_MAX_BATCH=20
# GET /sync/pull cursor lookback in seconds (20..3600): rows younger than this are re-sent so late-committing transactions are never skipped.
SYNC_PULL_LOOKBACK_SECONDS=60
# Queue enqueue timeout, ms (100..60000, default 3000) — Redis outage must not hang requests.
QUEUE_ENQUEUE_TIMEOUT_MS=3000
# Orphaned QUEUED export job is failed after this many ms (min 900000 = 15 min, default 86400000 = 24h).
ABANDONED_QUEUED_MS=86400000
# Visits whose startedAt is older than this many days (1..90) are rejected (future > 5 min always rejected).
VISIT_STARTED_AT_MAX_AGE_DAYS=30

# --- CORS (comma-separated allowed origins; web + miniapp dev ports by default) ---
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- Error tracking (optional — empty disables Sentry) ---
SENTRY_DSN=""

# --- SMS gateway (password reset codes; Eskiz.uz — empty logs the code
# instead of sending it, useful for local dev/testing without an account) ---
SMS_API_TOKEN=""
SMS_SENDER="4546"

# --- Seed (dev/demo only — packages/database/src/seed.ts refuses to run
# when NODE_ENV=production) ---
SEED_DEMO_PASSWORD="Velto#Demo2026"

# --- App ---
NODE_ENV="development"
API_PORT="3001"
WEB_PORT="3000"
MINIAPP_PORT="3002"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"






