# --- Database ---
DATABASE_URL="postgresql://velto:velto@localhost:5432/velto_dev?schema=public"
# BYPASSRLS role — used only for cross-tenant bootstrap (login-by-phone) and
# background jobs. See packages/database/scripts/provision-roles.sql.
DATABASE_SYSTEM_URL="postgresql://velto_system:velto_system@localhost:5432/velto_dev?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (S3-compatible / MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="velto"
S3_SECRET_KEY="velto12345"
S3_BUCKET="velto-dev"
S3_FORCE_PATH_STYLE="true"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=""
# Set when registering the webhook: `setWebhook` call's secret_token param.
TELEGRAM_WEBHOOK_SECRET=""
# Bot's @username without the "@" — only used to build supplier link deep links; empty means the UI shows the raw code instead.
TELEGRAM_BOT_USERNAME=""

# --- CORS (comma-separated allowed origins; web + miniapp dev ports by default) ---
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- Error tracking (optional — empty disables Sentry) ---
SENTRY_DSN=""

# --- SMS gateway (password reset codes; Eskiz.uz — empty logs the code
# instead of sending it, useful for local dev/testing without an account) ---
SMS_API_TOKEN=""
SMS_SENDER="4546"

# --- Seed (dev/demo only — packages/database/src/seed.ts refuses to run
# when NODE_ENV=production) ---
SEED_DEMO_PASSWORD="Velto#Demo2026"

# --- App ---
NODE_ENV="development"
API_PORT="3001"
WEB_PORT="3000"
MINIAPP_PORT="3002"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"






