# Velto pilot — TEMPLATE of <checkout>/.env.production.local (gitignored, chmod 600, owner = PM2 runtime user).
# Key names + REPLACE_ME markers only. Real values are generated ON THE SERVER, never committed, never pasted in chat.
# RULES: no inline comments after a value (ecosystem.config.js:24-29 readEnvFile keeps everything after '=' incl. "# ..."), no spaces around '='.
# Every REPLACE_ME is deliberately invalid: the API refuses to boot in production until it is replaced
# (apps/api/src/common/config/env.schema.ts:151-192). Full table: docs/release/PILOT-RUNTIME-SECRETS-CHECKLIST.md section 4.
# Backup/monitor secrets (/etc/velto/backup.env, /etc/velto/monitor.env, BACKUP_PASSPHRASE_FILE) live OUTSIDE the repo and OUTSIDE this file.

# --- process ---
# ecosystem.config.js sets NODE_ENV=production itself but NOT the next four.
# nginx (deploy/nginx.conf:46) and deploy.sh smoke (deploy.sh:94) expect 3101; code default is 3001.
API_PORT=3101
# default 0.0.0.0 (env.schema.ts:24); behind nginx it must be loopback.
API_HOST=127.0.0.1
# default false (env.schema.ts:134); without it all clients share one rate-limit bucket (nginx.conf:53).
TRUST_PROXY=true
# default is localhost (env.schema.ts:66).
CORS_ORIGINS=https://REPLACE_ME_PILOT_DOMAIN
APP_VERSION=REPLACE_ME_release_tag
GIT_SHA=REPLACE_ME_commit_sha

# --- database ---
# Three different roles. Passwords: openssl rand -base64 32 | tr -d '/+=\n'  (URL-safe).
# velto_app, RLS-bound runtime role.
DATABASE_URL=postgresql://velto_app:REPLACE_ME@127.0.0.1:5432/velto?schema=public
# velto_system, BYPASSRLS (login by phone, cross-tenant jobs).
DATABASE_SYSTEM_URL=postgresql://velto_system:REPLACE_ME@127.0.0.1:5432/velto?schema=public
# velto_owner, schema owner: used by deploy.sh only, stripped from the PM2 env (ecosystem.config.js:46-47).
DATABASE_MIGRATE_URL=postgresql://velto_owner:REPLACE_ME@127.0.0.1:5432/velto?schema=public
PRISMA_POOL_SIZE=30
PRISMA_SYSTEM_POOL_SIZE=5

# --- redis ---
# requirepass is mandatory in production (env.schema.ts:179-182).
REDIS_URL=redis://:REPLACE_ME@127.0.0.1:6379
BULLMQ_PREFIX=velto-pilot

# --- object storage ---
# App key limited to the bucket; NOT the backup/offsite key.
# S3_ENDPOINT is the public origin (deploy/README.md:270: SigV4 is signed over host+path).
S3_ENDPOINT=https://REPLACE_ME_PILOT_DOMAIN
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=velto-files
S3_FORCE_PATH_STYLE=true

# --- auth / crypto ---
# JWT_ACCESS_SECRET and OFFLINE_KEK_SECRET: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_ME
OFFLINE_KEK_SECRET=REPLACE_ME
OFFLINE_KEK_VERSION=1
OFFLINE_KEK_PREVIOUS_SECRETS=
# MFA_ENCRYPTION_KEY: openssl rand -base64 32 (base64 of exactly 32 bytes).
MFA_ENCRYPTION_KEY=REPLACE_ME

# --- integrations (empty = disabled, fail-closed) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SMS_API_TOKEN=
SENTRY_DSN=
