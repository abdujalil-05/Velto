# EXAMPLE of /etc/velto/backup.env (root:root, chmod 600, OUTSIDE the repo). Key names + safe samples only.
# Must be a DIFFERENT credential set than the app's env (/etc/velto/app.env: S3_*, DATABASE_URL, ...). No inline comments after values.
# DB: dedicated read-only role (packages/database/scripts/provision-backup-role.sql). velto_system is NOT used for backups.
DATABASE_BACKUP_URL=postgresql://velto_backup:CHANGE_ME@127.0.0.1:5432/velto
BACKUP_DIR=/var/backups/velto
BACKUP_STATUS_DIR=/var/lib/velto-backup
BACKUP_PASSPHRASE_FILE=/etc/velto/backup.pass
# tiered LOCAL retention: every set < BACKUP_KEEP_ALL_HOURS, then the first set of each day until BACKUP_RETENTION_DAYS, older deleted (offsite untouched)
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_ALL_HOURS=48
# group of the deploy user: may READ the ciphertext (0640 root:velto-deploy), never the passphrase
BACKUP_READ_GROUP=velto-deploy
# app env file (root reads it only to compare S3_ACCESS_KEY: backup keys must differ)
VELTO_APP_ENV_FILE=/etc/velto/app.env
# --- R1 manifest signature: a SEPARATE gpg signing key (NOT the encryption passphrase). Private key only here (root:root 0700 dir, created by velto-tmpfiles.conf).
BACKUP_SIGN_GNUPGHOME=/var/lib/velto-backup-sign
# fingerprint of the signing (sub)key; the key MUST have no passphrase unless BACKUP_SIGN_PASSPHRASE_FILE (root 600) is set
BACKUP_SIGN_KEY_FPR=CHANGE_ME_40_HEX
# BACKUP_SIGN_PASSPHRASE_FILE=/etc/velto/sign.pass
# Verification (backup host self-check + offsite-sync; the restore workstation sets the same two with ITS OWN copies, never taken from a backup):
# exported PUBLIC key (gpg --export <fpr> > file) and the pinned PRIMARY-key fingerprints, space/comma separated (two entries while rotating)
BACKUP_VERIFY_KEYRING=/etc/velto/backup-sign-public.gpg
BACKUP_TRUSTED_SIGN_FPRS=CHANGE_ME_PRIMARY_FPR_40_HEX
# --- object store (D-1): READ-ONLY identity on the app bucket (policies/backup-reader-app-bucket.json)
OBJECTS_BACKUP_ENABLED=1
OBJECTS_SRC_ENDPOINT=https://s3.app-provider.example
OBJECTS_SRC_BUCKET=velto-files
OBJECTS_SRC_ACCESS_KEY_ID=CHANGE_ME_READ_ONLY_KEY
OBJECTS_SRC_SECRET_ACCESS_KEY=CHANGE_ME
OBJECTS_MIN_FREE_MB=2048
# --- offsite (backup-writer, PUT-ONLY: policies/offsite-backup-writer-put-only.json); bucket with versioning + Object Lock 30 d
OFFSITE_ENABLED=0
OFFSITE_BUCKET=velto-offsite-backups
OFFSITE_S3_ENDPOINT=https://s3.offsite-provider.example
OFFSITE_S3_ACCESS_KEY_ID=CHANGE_ME_PUT_ONLY_KEY
OFFSITE_S3_SECRET_ACCESS_KEY=CHANGE_ME
# R2 read-back identity (MANDATORY, GET+LIST only: policies/offsite-restore-read.json; a THIRD key, different from the writer and the app). Without it offsite-sync fails closed (exit 11).
OFFSITE_VERIFY_S3_ACCESS_KEY_ID=CHANGE_ME_READ_ONLY_KEY
OFFSITE_VERIFY_S3_SECRET_ACCESS_KEY=CHANGE_ME
OFFSITE_MAX_AGE=3d
# Alert hook (optional; else velto-monitor --alert; else logger). Absolute path, executable, not group/world-writable. Called: cmd <severity> <incident-id> <message>
# BACKUP_ALERT_CMD=/etc/velto/alert-telegram.sh
