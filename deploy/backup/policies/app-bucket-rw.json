{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppObjectsReadWriteNoDelete",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::velto-files/*"
      ]
    },
    {
      "Sid": "AppHeadBucketForReadiness",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::velto-files"
      ]
    },
    {
      "Sid": "AppNeverDeletesOrAdministers",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::velto-files",
        "arn:aws:s3:::velto-files/*"
      ]
    }
  ]
}
