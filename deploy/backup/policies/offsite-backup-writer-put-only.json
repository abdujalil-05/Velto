{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriterPutAndListNamesOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::velto-offsite-backups", "arn:aws:s3:::velto-offsite-backups/*"]
    },
    {
      "Sid": "WriterCannotReadDeleteOrAdminister",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject", "s3:GetObjectVersion",
        "s3:DeleteObject", "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention", "s3:PutObjectRetention", "s3:PutObjectLegalHold",
        "s3:PutBucketPolicy", "s3:PutLifecycleConfiguration", "s3:PutBucketVersioning", "s3:PutBucketObjectLockConfiguration"
      ],
      "Resource": ["arn:aws:s3:::velto-offsite-backups", "arn:aws:s3:::velto-offsite-backups/*"]
    }
  ]
}
