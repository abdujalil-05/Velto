# EXAMPLE, not installed by the repo. Install (user action, on the server, as root):
#   1. Root-owned copy of the scripts (NOT the writable git checkout: whoever can write the checkout would get root). Re-run after every git pull:
#        install -d -m 755 -o root -g root /opt/velto/deploy/backup /opt/velto/deploy/monitoring
#        install -m 755 -o root -g root deploy/backup/{backup-run,backup,offsite-sync}.sh deploy/backup/pg-conn.sh /opt/velto/deploy/backup/
#        install -m 755 -o root -g root deploy/monitoring/velto-monitor.sh /opt/velto/deploy/monitoring/   # + /usr/local/bin/velto-monitor (see monitoring/README.md)
#   2. install -m 600 -o root -g root backup.env.example /etc/velto/backup.env   (fill on the server; set BACKUP_DIR below to the same path)
#   3. cp velto-backup.service.example /etc/systemd/system/velto-backup.service   (adjust BACKUP_DIR in ReadWritePaths)
#      cp velto-backup.timer.example   /etc/systemd/system/velto-backup.timer
#      systemctl daemon-reload && systemctl enable --now velto-backup.timer
#   Check the sandbox: systemd-analyze security velto-backup.service ; first run: systemctl start velto-backup.service && journalctl -u velto-backup -n 30
# Why root (not a dedicated user): backup.env holds DATABASE_SYSTEM_URL and the same BACKUP_DIR is written by deploy.sh (root) before each
# deploy, and backup-run.sh switches to the velto-monitor user (runuser) to raise alerts, which needs the Telegram token (root:velto-monitor 640).
# Mitigation instead of a second user: sandbox below, scripts from a root-owned path, capabilities cut to what runuser needs.
# If you alert via BACKUP_ALERT_CMD only (no velto-monitor), use CapabilityBoundingSet= (empty) and drop /var/lib/velto-monitor from ReadWritePaths.
[Unit]
Description=Velto encrypted DB backup + offsite copy
# Optional: OnFailure=velto-backup-alert.service  (a oneshot that calls your alert channel)

[Service]
Type=oneshot
EnvironmentFile=/etc/velto/backup.env
ExecStart=/opt/velto/deploy/backup/backup-run.sh
Environment=VELTO_MONITOR_BIN=/usr/local/bin/velto-monitor
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
# --- sandbox ---
NoNewPrivileges=yes
ProtectSystem=strict
# BACKUP_DIR (backups) + monitor dedup state (written by the velto-monitor user via runuser). Both must exist before start (ReadWritePaths fails on a missing path).
ReadWritePaths=/var/backups/velto /var/lib/velto-monitor
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Only runuser (alert as velto-monitor) needs SETUID/SETGID; no DAC_OVERRIDE/CHOWN: files must be owned by root (0600) as backup.sh creates them.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
# gpg/rclone want a home dir; /root is hidden by ProtectHome, so give them a private tmpfs-backed one.
RuntimeDirectory=velto-backup
RuntimeDirectoryMode=0700
Environment=HOME=/run/velto-backup GNUPGHOME=/run/velto-backup/gnupg XDG_CACHE_HOME=/run/velto-backup
