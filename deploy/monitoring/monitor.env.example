# /etc/velto/monitor.env  (root:velto-monitor, chmod 640). Real values ONLY on the server, never in git/chat.
# separate OPS bot (BotFather); NOT the app TELEGRAM_BOT_TOKEN
OPS_TG_BOT_TOKEN=
# ops person/group chat id (numeric)
OPS_TG_CHAT_ID=
MONITOR_HOST_LABEL=velto-pilot
# REQUIRED, no default; PASS only on HTTP 200 + body {"status":"up","checks":{...}} from the API
VELTO_API_HEALTH_URL=https://auto-message.uz/velto/api/health/ready
# nginx access-log path prefix for api_5xx
MONITOR_5XX_PATH_PREFIX=/velto/api/
# --alert dedup per incident id
MONITOR_ALERT_COOLDOWN_SECONDS=3600
MONITOR_TLS_HOST=auto-message.uz
MONITOR_TLS_WARN_DAYS=14
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MONITOR_5XX_WINDOW_LINES=2000
MONITOR_5XX_MIN_COUNT=5
MONITOR_5XX_MIN_PERCENT=5
BACKUP_DIR=/var/backups/velto
MONITOR_BACKUP_MAX_AGE_HOURS=26
# hourly timer + RandomizedDelay + run duration
MONITOR_BACKUP_MAX_AGE_MINUTES=100
# Offsite RPO = now - offsite_restore_point_ts (status file). CRIT must stay < RPO 60 - 5 min run interval - delivery.
MONITOR_OFFSITE_RPO_WARN_MINUTES=40
MONITOR_OFFSITE_RPO_CRIT_MINUTES=50
MONITOR_DISK_PATHS="/ /var/backups"
MONITOR_DISK_WARN_PERCENT=80
# Read-only monitor DB role (see monitor-role.sql). Empty MONITOR_DB_NAME = job checks skipped (reported as SKIP).
MONITOR_DB_HOST=127.0.0.1
MONITOR_DB_PORT=5432
MONITOR_DB_NAME=
MONITOR_DB_USER=velto_monitor
# written to a temp 0600 PGPASSFILE per run; never in argv
MONITOR_DB_PASSWORD=
# Backoff-aware stale thresholds (jobs_stale, job_mismatch): Notification PENDING past COALESCE(next attempt, updatedAt) / SENDING past claim / Import past recovery backoff + grace / Export age
MONITOR_STALE_NOTIF_MINUTES=15
MONITOR_STALE_SENDING_MINUTES=10
MONITOR_STALE_IMPORT_GRACE_MINUTES=10
MONITOR_STALE_EXPORT_MINUTES=25
MONITOR_JOB_FAILED_WINDOW_MINUTES=60
MONITOR_JOB_FAILED_MAX=5
# = systemd StateDirectory=velto-monitor
MONITOR_STATE_DIR=/var/lib/velto-monitor
MONITOR_REPEAT_MINUTES=360
# Redis (read-only ACL user, README). Empty user+password = redis/queue checks SKIP. A password with an empty or `default` user = redis FAIL (user is required).
MONITOR_REDIS_HOST=127.0.0.1
MONITOR_REDIS_PORT=6379
MONITOR_REDIS_USER=velto_monitor
MONITOR_REDIS_PASSWORD=
# REQUIRED when Redis is configured, NO default: must equal the app BULLMQ_PREFIX (pilot: velto-pilot, deploy/env.production.example). Wrong value = CRIT queue_meta.
MONITOR_BULLMQ_PREFIX=velto-pilot
MONITOR_QUEUES="idempotency-cleanup reconciliation-daily company-export 1c-export import-commit notification-telegram"
MONITOR_QUEUE_WAIT_AGE_WARN_MINUTES=10
MONITOR_QUEUE_WAIT_AGE_CRIT_MINUTES=30
# Active-job age limit per queue (WARN > limit, CRIT > 2x limit); queues not listed use MONITOR_QUEUE_ACTIVE_LIMIT_MINUTES
MONITOR_QUEUE_ACTIVE_LIMITS="notification-telegram=5 1c-export=15 company-export=30 import-commit=30"
MONITOR_QUEUE_ACTIVE_LIMIT_MINUTES=30
# delayed is never CRIT; WARN only when the earliest delayed job is this overdue
MONITOR_QUEUE_DELAYED_OVERDUE_MINUTES=15
# failed jobs ADDED since the previous run (not the absolute total)
MONITOR_QUEUE_FAILED_DELTA_WARN=1
MONITOR_QUEUE_FAILED_DELTA_CRIT=10
MONITOR_NOWORKER_PROBE_SECONDS=3
