# /etc/velto/monitor.env  (root:velto-monitor, chmod 640). Real values ONLY on the server, never in git/chat.
OPS_TG_BOT_TOKEN=            # separate OPS bot (BotFather); NOT the app TELEGRAM_BOT_TOKEN
OPS_TG_CHAT_ID=              # ops person/group chat id (numeric)
MONITOR_HOST_LABEL=velto-pilot
VELTO_API_HEALTH_URL=https://auto-message.uz/velto/api/health/ready   # REQUIRED, no default; PASS only on HTTP 200 + body {"status":"up","checks":{...}} from the API
MONITOR_5XX_PATH_PREFIX=/velto/api/   # nginx access-log path prefix for api_5xx
MONITOR_ALERT_COOLDOWN_SECONDS=3600   # --alert dedup per incident id
MONITOR_TLS_HOST=auto-message.uz
MONITOR_TLS_WARN_DAYS=14
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MONITOR_5XX_WINDOW_LINES=2000
MONITOR_5XX_MIN_COUNT=5
MONITOR_5XX_MIN_PERCENT=5
BACKUP_DIR=/var/backups/velto
MONITOR_BACKUP_MAX_AGE_HOURS=26
MONITOR_BACKUP_MAX_AGE_MINUTES=100    # hourly timer + RandomizedDelay + run duration
MONITOR_OFFSITE_MAX_AGE_MINUTES=180   # offsite_ts = last confirmed offsite copy
MONITOR_DISK_PATHS="/ /var/backups"
MONITOR_DISK_WARN_PERCENT=80
# Read-only monitor DB role (see monitor-role.sql). Empty MONITOR_DB_NAME = job checks skipped (reported as SKIP).
MONITOR_DB_HOST=127.0.0.1
MONITOR_DB_PORT=5432
MONITOR_DB_NAME=
MONITOR_DB_USER=velto_monitor
MONITOR_DB_PASSWORD=   # written to a temp 0600 PGPASSFILE per run; never in argv
MONITOR_JOB_STUCK_MINUTES=30
MONITOR_NOTIF_STUCK_MINUTES=30
MONITOR_JOB_FAILED_WINDOW_MINUTES=60
MONITOR_JOB_FAILED_MAX=5
MONITOR_STATE_DIR=/var/lib/velto-monitor   # = systemd StateDirectory=velto-monitor
MONITOR_REPEAT_MINUTES=360
