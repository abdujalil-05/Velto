{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "test:perf": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_SYSTEM_URL",
        "DATABASE_MIGRATE_URL",
        "DATABASE_ADMIN_URL",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "MFA_ENCRYPTION_KEY",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "CORS_ORIGINS",
        "SEED_DEMO_PASSWORD",
        "VITEST_MAX_FORKS"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_SYSTEM_URL",
        "DATABASE_MIGRATE_URL",
        "DATABASE_ADMIN_URL",
        "REDIS_URL",
        "JWT_ACCESS_SECRET",
        "MFA_ENCRYPTION_KEY",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "CORS_ORIGINS",
        "SEED_DEMO_PASSWORD",
        "VITEST_MAX_FORKS"
      ]
    }
  }
}
