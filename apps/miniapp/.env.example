NEXT_PUBLIC_API_URL="http://localhost:3001"

# Telegram bot username (without @) — used by the fallback screen to build the
# t.me deep link when the Mini App is opened outside Telegram or initData is
# invalid. Build-time variable: restart/rebuild the miniapp after changing it.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Yandex Maps JS API key (public/client-side, restricted by domain in the
# Yandex developer console) — leave empty to show a "map unavailable" card
# instead of crashing the route/visit screens.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""
